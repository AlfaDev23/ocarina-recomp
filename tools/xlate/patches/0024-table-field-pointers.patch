+        // address = ... + Load(table, (cb0[w] + K - (cb0[w] & -16)) >> 2): the load, w and K.
+        private static bool FindLoadedPointer(Operand address, int depth, out Operand pointer, out int word, out int field)
+        {
+            pointer = null;
+            word = field = 0;
+            if (depth == 0 || address.AsgOp is not Operation op)
+            {
+                return false;
+            }
+
+            if (op.Inst == Instruction.Add)
+            {
+                return FindLoadedPointer(op.GetSource(0), depth - 1, out pointer, out word, out field) ||
+                       FindLoadedPointer(op.GetSource(1), depth - 1, out pointer, out word, out field);
+            }
+
+            if (op.Inst != Instruction.Load || op.StorageKind != StorageKind.StorageBuffer || op.SourcesCount < 3 ||
+                op.GetSource(2).AsgOp is not Operation shift || shift.Inst != Instruction.ShiftRightU32 ||
+                shift.GetSource(0).AsgOp is not Operation sub || sub.Inst != Instruction.Subtract)
+            {
+                return false;
+            }
+
+            Operand start = sub.GetSource(0);
+            if (start.AsgOp is Operation add && add.Inst == Instruction.Add && add.GetSource(1).Type == OperandType.Constant)
+            {
+                field = add.GetSource(1).Value;
+                start = add.GetSource(0);
+            }
+
+            if (start.Type != OperandType.ConstantBuffer || start.GetCbufSlot() != 0)
+            {
+                return false;
+            }
+
+            word = start.GetCbufOffset();
+            pointer = address;
             return true;
