+        // LOCAL TEST (Ocarina): the expression behind a handle nothing resolved.
+        private static string DescribeHandle(Operand o, int depth)
+        {
+            if (o.Type == OperandType.Constant) return "#" + o.Value.ToString("x");
+            if (o.Type == OperandType.ConstantBuffer) return "cb" + o.GetCbufSlot() + "[" + o.GetCbufOffset() + "]";
+            if (o.AsgOp is PhiNode phi)
+            {
+                string p = "phi(";
+                for (int i = 0; i < phi.SourcesCount && depth > 0; i++) p += (i != 0 ? "," : "") + DescribeHandle(phi.GetSource(i), depth - 1);
+                return p + ")";
+            }
+            if (o.AsgOp is not Operation op) return o.Type.ToString();
+            if (depth == 0) return op.Inst.ToString() + "..";
+            string args = "";
+            for (int i = 0; i < op.SourcesCount; i++) args += (i != 0 ? "," : "") + DescribeHandle(op.GetSource(i), depth - 1);
+            return op.Inst + (op.StorageKind != StorageKind.None ? ":" + op.StorageKind : "") + "(" + args + ")";
         }
 
