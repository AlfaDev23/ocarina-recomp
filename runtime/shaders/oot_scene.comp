#version 450
// LOCAL TEST (Ocarina): stands in for the game's upscaler: the tone map's output is the square root of the colour.
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, r11f_g11f_b10f) uniform writeonly image2D dst;
layout(push_constant) uniform P { vec2 inv; } p;
void main() {
    vec2 uv = (vec2(gl_GlobalInvocationID.xy) + 0.5) * p.inv;
    vec3 c = textureLod(src, uv, 0.0).rgb;
    imageStore(dst, ivec2(gl_GlobalInvocationID.xy), vec4(c * c, 1.0));
}
